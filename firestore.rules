rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All reads/writes require authentication
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Tasks: team members can read/write their team's tasks
    match /tasks/{taskId} {
      allow read, write: if request.auth != null;
    }

    // Meetings: authenticated users can read/write
    match /meetings/{meetingId} {
      allow read, write: if request.auth != null;
    }

    // Code reviews: authenticated users can read
    match /codeReviews/{reviewId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Teams: authenticated users
    match /teams/{teamId} {
      allow read, write: if request.auth != null;
    }

    // Users: users can read any profile, write only their own
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
